NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://gatherly:gatherly@localhost:54329/gatherly
TEST_DATABASE_URL=postgres://gatherly:gatherly@localhost:54329/gatherly_test
LOG_LEVEL=info
# Public demo: persona sign-in, demo reset and seeding at boot. Leave unset (false) for real deployments.
DEMO_MODE=true
# Wait for a busy event row before answering 503 EVENT_BUSY (default 3000).
# SEAT_LOCK_TIMEOUT_MS=3000
# Reverse proxies in front of the API (0 = none). Replit sets 1.
# TRUST_PROXY_HOPS=0
# Telemetry (optional; unset = off). Grafana Cloud OTLP gateway + Sentry gatherly-api project.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-3.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instanceId:token>
# SENTRY_DSN_API=
# Web (build time; unset = Sentry off in the browser). Sentry gatherly-web project.
# VITE_SENTRY_DSN=
