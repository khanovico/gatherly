    {
      "id": 17,
      "type": "logs",
      "title": "Recent API logs",
      "description": "Allowlisted fields only: level, method, route template, status, duration and trace_id. No IP addresses, query strings or user data.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "expr": "{service_name=\"gatherly-api\"} != \"incoming request\" | keep service_name, detected_level, trace_id, method, route, status, durationMs | route=~\"/api/.+\" or detected_level=~\"error|warn\" | line_format \"{{if .route}}{{.method}} {{.route}} \u2192 {{.status}} in {{.durationMs}} ms{{else}}{{__line__}}{{end}}\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 18,
      "type": "table",
      "title": "Recent API requests",
      "description": "From the request logs (public dashboards cannot query Tempo). Copy a trace ID to match the x-trace-id response header or a Sentry event.",
      "datasource": {
        "type": "loki",
        "uid": "grafanacloud-logs"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "grafanacloud-logs"
          },
          "queryType": "range",
          "maxLines": 50,
          "expr": "{service_name=\"gatherly-api\"} |= \"request completed\" | keep trace_id, method, route, status, durationMs | route=~\"/api/.+\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "labels": true,
              "Line": true,
              "tsNs": true,
              "id": true,
              "labelTypes": true,
              "detected_level": true,
              "service_name": true,
              "traceID": true,
              "traceID (field)": true
            },
            "indexByName": {
              "Time": 0,
              "method": 1,
              "route": 2,
              "status": 3,
              "durationMs": 4,
              "trace_id": 5
            },
            "renameByName": {
              "method": "Method",
              "route": "Route",
              "status": "Status",
              "durationMs": "Duration (ms)",
              "trace_id": "Trace ID"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
